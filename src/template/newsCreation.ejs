<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Agregar Noticia | Noticias UPB</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/banner.css" />
  </head>

  <body class="bg-light">
    <!-- Banner -->
    <%- include('./banner') %>

    <main class="container my-5">
      <div class="card shadow-sm p-4">
        <h2 class="mb-4 text-danger fw-bold text-uppercase">
          Agregar nueva noticia
        </h2>

        <!-- ✅ Alerta de éxito -->
        <% if (typeof success !=='undefined' && success) { %>
        <div class="alert alert-success" role="alert">
          ¡Noticia registrada correctamente!
        </div>
        <% } else { %>

        <div class="d-flex justify-content-between mt-4">
          <a
            href="http://localhost:1888/news/v1.0/news/main"
            class="btn btn-secondary"
          >
            ← Volver
          </a>
        </div>

        <form
          action="http://localhost:1888/news/v1.0/news"
          method="POST"
          enctype="multipart/form-data"
        >
          <!-- Título -->
          <div class="mb-3">
            <label class="form-label">Título</label>
            <input
              type="text"
              class="form-control"
              name="title"
              placeholder="Ej. EcoTrack: Monitoreo ambiental con IoT"
              required
            />
          </div>

          <!-- Nombre del proyecto -->
          <div class="mb-3">
            <label class="form-label">Nombre del Proyecto</label>
            <input
              type="text"
              class="form-control"
              name="projectName"
              placeholder="Ej. EcoTrack"
              required
            />
          </div>

          <!-- Materia -->
          <div class="mb-3">
            <label class="form-label">Materia</label>
            <input
              type="text"
              class="form-control"
              name="subject"
              placeholder="Ej. IoT y Cloud Computing"
              required
            />
          </div>

          <!-- Integrantes -->
          <div class="mb-3">
            <label class="form-label">Integrantes del Grupo</label>
            <div id="members-container">
              <input
                type="text"
                class="form-control mb-2"
                name="groupMembers[]"
                placeholder="Ej. Juan Pérez"
                required
              />
            </div>
            <button
              type="button"
              class="btn btn-sm btn-outline-primary"
              onclick="addMember()"
            >
              + Agregar integrante
            </button>
          </div>

          <!-- Descripción corta -->
          <div class="mb-3">
            <label class="form-label">Descripción corta</label>
            <textarea
              class="form-control"
              name="shortDescription"
              rows="2"
              placeholder="Resumen breve de la noticia"
              required
            ></textarea>
          </div>

          <!-- Contenido -->
          <div class="mb-3">
            <label class="form-label">Contenido</label>
            <textarea
              class="form-control"
              name="content"
              rows="6"
              placeholder="Desarrolla el contenido completo de la noticia..."
              required
            ></textarea>
          </div>

          <!-- Imagen principal -->
          <div class="mb-3">
            <label class="form-label">Imagen principal</label>
            <input
              type="file"
              class="form-control"
              name="mainImage"
              accept="image/*"
              required
            />
          </div>

          <!-- Fecha -->
          <div class="mb-3">
            <label class="form-label">Fecha</label>
            <input type="date" class="form-control" name="date" required />
          </div>
          <!-- 🔥 Sección de múltiples frases célebres -->
          <div class="mb-4">
            <label class="form-label fw-semibold text-danger"
              >Frases célebres / Comentarios (opcional)</label
            >
            <div id="quotes-container" class="border rounded p-3 bg-light">
              <div class="quote-item mb-3 p-3 border rounded bg-white">
                <label class="form-label">Frase</label>
                <textarea
                  class="form-control mb-2"
                  name="quotes[0][quote]"
                  rows="2"
                  placeholder="Ej. La innovación distingue a los líderes de los seguidores."
                ></textarea>

                <label class="form-label">Autor</label>
                <input
                  type="text"
                  class="form-control mb-2"
                  name="quotes[0][quoteAuthor]"
                  placeholder="Ej. Steve Jobs"
                />

                <label class="form-label">Imagen del autor</label>
                <input
                  type="file"
                  class="form-control"
                  name="quoteImages"
                  accept="image/*"
                />
              </div>
            </div>

            <button
              type="button"
              class="btn btn-sm btn-outline-primary mt-2"
              onclick="addQuote()"
            >
              + Agregar otra frase
            </button>
          </div>

          <!-- Botón -->
          <button type="submit" class="btn btn-danger fw-semibold">
            Publicar noticia
          </button>
        </form>
      </div>
      <% } %>
    </main>

    <script>
      function addMember() {
        const container = document.getElementById("members-container");
        const input = document.createElement("input");
        input.type = "text";
        input.name = "groupMembers[]";
        input.classList.add("form-control", "mb-2");
        input.placeholder = "Ej. Nuevo integrante";
        container.appendChild(input);
      }

      // 🔥 Permite agregar más bloques de frases
      let quoteCount = 1;
      function addQuote() {
        const container = document.getElementById("quotes-container");
        const div = document.createElement("div");
        div.classList.add(
          "quote-item",
          "mb-3",
          "p-3",
          "border",
          "rounded",
          "bg-white"
        );

        div.innerHTML = `
    <label class="form-label">Frase</label>
    <textarea
      class="form-control mb-2"
      name="quotes[${quoteCount}][quote]"
      rows="2"
      placeholder="Ej. La mejor forma de predecir el futuro es crearlo."
    ></textarea>

    <label class="form-label">Autor</label>
    <input
      type="text"
      class="form-control mb-2"
      name="quotes[${quoteCount}][quoteAuthor]"
      placeholder="Ej. Peter Drucker"
    />

    <label class="form-label">Imagen del autor</label>
    <input
      type="file"
      class="form-control"
      name="quoteImages"
      accept="image/*"
    />
  `;
        container.appendChild(div);
        quoteCount++;
      }
    </script>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
